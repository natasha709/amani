{
  "watch": ["src"],
  "ext": "ts,json",
  "ignore": ["node_modules", "dist", "coverage", "*.test.ts", "*.spec.ts"],
  "exec": "ts-node-dev --respawn --transpile-only src/index.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": true,
  "legacyWatch": false,
  "stdout": true
}
